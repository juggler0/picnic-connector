# Copy the names below into Netlify → Project configuration → Environment variables.
# Do NOT create a real .env file with values in this repository.

# Required: a long random secret (at least 32 characters), e.g. `openssl rand -hex 32`.
CONNECTOR_SECRET=

# Optional: NL (default), DE or FR.
PICNIC_COUNTRY=

# Optional: comma-separated IP prefixes that may call the connector, e.g. "160.79.,153.61.".
ALLOWED_IP_PREFIXES=

# Optional: Notion internal integration secret, enables the order-history copy to Notion.
NOTION_TOKEN=

# Optional: family menu website logins, Name:PIN pairs (PIN 4-8 digits). The first name is the owner.
MENU_USERS=
# Optional: who may change dishes, if not the first name in MENU_USERS.
MENU_OWNER=
